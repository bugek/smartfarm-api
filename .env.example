PORT=3200
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartfarm_api?schema=public"

# Public base URL the API uses to mint presigned upload/download links.
PUBLIC_BASE_URL="http://localhost:3200"

# Local-disk blob storage root (overrides ./data/storage).
DOCUMENT_STORAGE_DIR=

# HMAC secret for presigned blob tokens. MUST be overridden in non-dev environments.
DOCUMENT_SIGNING_SECRET="smartfarm-dev-document-signing-secret"

# HMAC secret for bearer access and refresh tokens. MUST be overridden in non-dev environments.
AUTH_TOKEN_SECRET="smartfarm-dev-auth-token-secret"
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Local-only bootstrap credentials so smartfarm-web can validate auth/session flows
# before a full user-management surface exists.
AUTH_BOOTSTRAP_EMAIL="demo@smartfarm.local"
AUTH_BOOTSTRAP_PASSWORD="smartfarm-demo"
AUTH_BOOTSTRAP_DISPLAY_NAME="Demo Farmer"
AUTH_BOOTSTRAP_ORGANIZATION_NAME="SmartFarm Demo Organization"

# Background document job poll interval in ms.
DOCUMENT_JOB_INTERVAL_MS=5000
# Set to "true" to disable the in-process job runner (e.g. when running a dedicated worker).
DOCUMENT_JOB_RUNNER_DISABLED=

