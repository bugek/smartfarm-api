generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  admin
  compliance_lead
  expert
  worker
}

enum GapRecordStatus {
  draft
  submitted
  reviewed
  needs_action
  approved
}

enum EvidenceKind {
  image
  video
  document
}

enum EvidenceReviewStatus {
  pending_review
  verified
  needs_rework
}

enum EvidenceReviewDecision {
  verified
  needs_rework
  comment
}

enum ReviewThreadStatus {
  awaiting_review
  changes_requested
  approved
  rejected
}

enum DocumentKind {
  image
  video
  pdf
  spreadsheet
  other
}

enum DocumentStatus {
  pending_upload
  uploaded
  processing
  ready
  failed
  quarantined
}

enum DocumentJobKind {
  validate_blob
  extract_text
}

enum DocumentJobStatus {
  pending
  running
  succeeded
  failed
  retrying
  dead_letter
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  farmSites   FarmSite[]
  cropCycles  CropCycle[]
  workers     Worker[]
  operationLogs OperationLog[]
  gapRecords  GapRecord[]
  auditEvents AuditEvent[]
  documents   Document[]
  evidences   Evidence[]
  evidenceReviews EvidenceReview[]
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  displayName String
  passwordHash String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships Membership[]
  comments    AdvisoryComment[]
  authSessions AuthSession[]
}

model AuthSession {
  id                    String    @id
  userId                String
  refreshTokenHash      String    @unique
  refreshTokenExpiresAt DateTime
  revokedAt             DateTime?
  lastUsedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshTokenExpiresAt])
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

model FarmSite {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  code           String?
  locationText   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plots          Plot[]
  cropCycles     CropCycle[]
  workers        Worker[]
  operationLogs  OperationLog[]

  @@index([organizationId])
}

model Plot {
  id          String    @id @default(cuid())
  farmSiteId  String
  name        String
  areaRai     Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  farmSite    FarmSite  @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  cropCycles  CropCycle[]
  operationLogs OperationLog[]

  @@index([farmSiteId])
}

model CropCycle {
  id             String      @id @default(cuid())
  organizationId String
  farmSiteId     String
  plotId         String?
  cropName       String
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite       FarmSite    @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  plot           Plot?       @relation(fields: [plotId], references: [id], onDelete: SetNull)
  operationLogs  OperationLog[]
  gapRecords     GapRecord[]

  @@index([organizationId, farmSiteId])
}

model Worker {
  id             String       @id @default(cuid())
  organizationId String
  farmSiteId     String?
  fullName       String
  phone          String?
  roleTitle      String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite       FarmSite?    @relation(fields: [farmSiteId], references: [id], onDelete: SetNull)
  operationLogs  OperationLog[]

  @@index([organizationId, isActive, createdAt])
  @@index([farmSiteId])
}

model OperationLog {
  id             String       @id @default(cuid())
  organizationId String
  farmSiteId     String
  plotId         String?
  cropCycleId    String?
  workerId       String?
  activityType   String
  occurredAt     DateTime
  notes          String?
  metadataJson   Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite       FarmSite     @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  plot           Plot?        @relation(fields: [plotId], references: [id], onDelete: SetNull)
  cropCycle      CropCycle?   @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  worker         Worker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, farmSiteId, occurredAt])
  @@index([cropCycleId, occurredAt])
  @@index([workerId, occurredAt])
}

model GapChecklist {
  id          String      @id @default(cuid())
  code        String      @unique
  title       String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  gapRecords  GapRecord[]
}

model GapRecord {
  id              String          @id @default(cuid())
  organizationId  String
  cropCycleId     String?
  checklistId     String?
  title           String
  notes           String?
  status          GapRecordStatus @default(draft)
  reviewThreadStatus ReviewThreadStatus @default(awaiting_review)
  recordedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cropCycle       CropCycle?      @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  checklist       GapChecklist?   @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  evidences       Evidence[]
  comments        AdvisoryComment[]

  @@index([organizationId, status])
}

model Evidence {
  id                   String               @id @default(cuid())
  organizationId       String
  gapRecordId          String
  controlPointRef      String?
  kind                 EvidenceKind
  storageKey           String
  fileName             String
  contentType          String?
  fileSize             Int?
  capturedAt           DateTime?
  geoLat               Float?
  geoLng               Float?
  noteText             String?
  documentId           String?
  submittedByUserId    String?
  submittedAt          DateTime?
  reviewStatus         EvidenceReviewStatus @default(pending_review)
  lastReviewedByUserId String?
  lastReviewedAt       DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gapRecord            GapRecord            @relation(fields: [gapRecordId], references: [id], onDelete: Cascade)
  document             Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reviews              EvidenceReview[]

  @@index([gapRecordId, kind])
  @@index([documentId])
  @@index([organizationId, reviewStatus, createdAt])
  @@index([organizationId, controlPointRef, reviewStatus])
}

model EvidenceReview {
  id               String                 @id @default(cuid())
  evidenceId       String
  organizationId   String
  reviewerUserId   String
  decision         EvidenceReviewDecision
  comment          String
  createdAt        DateTime               @default(now())
  evidence         Evidence               @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([evidenceId, createdAt])
  @@index([organizationId, decision, createdAt])
}

model AdvisoryComment {
  id          String    @id @default(cuid())
  gapRecordId String
  authorUserId String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  gapRecord   GapRecord @relation(fields: [gapRecordId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([gapRecordId, createdAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  entityType     String
  entityId       String
  action         String
  payloadJson    Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
}

model Document {
  id              String         @id @default(cuid())
  organizationId  String
  uploadedByUserId String?
  kind            DocumentKind
  status          DocumentStatus @default(pending_upload)
  fileName        String
  contentType     String?
  declaredSize    Int?
  storageProvider String         @default("local_disk")
  storageKey      String         @unique
  blobSize        Int?
  blobSha256      String?
  uploadedAt      DateTime?
  finalizedAt     DateTime?
  failureReason   String?
  metadataJson    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs            DocumentJob[]
  evidences       Evidence[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model DocumentJob {
  id             String            @id @default(cuid())
  documentId     String
  organizationId String
  kind           DocumentJobKind
  status         DocumentJobStatus @default(pending)
  attemptCount   Int               @default(0)
  maxAttempts    Int               @default(3)
  scheduledAt    DateTime          @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  lastErrorMessage String?
  resultJson     Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  document       Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([documentId, kind])
  @@index([organizationId, status])
}
