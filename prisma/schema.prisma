generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  admin
  compliance_lead
  expert
  worker
}

enum GapRecordStatus {
  draft
  submitted
  reviewed
  needs_action
  approved
}

enum EvidenceKind {
  image
  video
  document
}

enum EvidenceReviewStatus {
  pending_review
  verified
  needs_rework
}

enum EvidenceReviewDecision {
  verified
  needs_rework
  comment
}

enum ReviewThreadStatus {
  awaiting_review
  changes_requested
  approved
  rejected
}

enum CorrectiveActionStatus {
  open_unassigned
  assigned
  submitted_for_review
  verified
  closed
}

enum GapRecordVersionReviewDecision {
  approved
  needs_more_evidence
  blocking
  comment
}

enum DocumentKind {
  image
  video
  pdf
  spreadsheet
  other
}

enum DocumentStatus {
  pending_upload
  uploaded
  processing
  ready
  failed
  quarantined
}

enum DocumentJobKind {
  validate_blob
  extract_text
}

enum DocumentJobStatus {
  pending
  running
  succeeded
  failed
  retrying
  dead_letter
}

enum ComplianceSchemeStatus {
  draft
  active
  retired
}

enum TraceLotStatus {
  open
  on_hold
  released
  shipped
  recalled
  closed
}

enum TraceLotLineageRelationshipType {
  split
  merge
  repack
  relabel
}

enum TraceLotGapRecordLinkType {
  evidence_source
  release_gate
  supporting_record
}

enum TraceDispatchDestinationType {
  customer
  warehouse
  processor
  internal
}

enum TraceDispatchStatus {
  draft
  dispatched
  acknowledged
  recalled
  cancelled
}

enum TraceabilityExerciseStatus {
  draft
  running
  completed
  failed
}

enum RetentionSubjectType {
  gap_record
  evidence
  document
  trace_lot
  trace_dispatch
  traceability_exercise
  audit_packet
  derived_artifact
  job_artifact
}

enum RetentionExecutionDecision {
  archived
  purged
  skipped_hold
  skipped_not_due
}

enum RetentionExecutionActorType {
  system
  user
}

enum HazardousSubstanceProductStatus {
  active
  inactive
}

enum HazardousSubstanceStockEventType {
  received
  used
  adjusted
  disposed
}

enum HazardousSubstanceStorageCheckResult {
  pass
  needs_action
}

model Organization {
  id                              String                           @id @default(cuid())
  name                            String
  description                     String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  memberships                     Membership[]
  farmSites                       FarmSite[]
  cropCycles                      CropCycle[]
  workers                         Worker[]
  operationLogs                   OperationLog[]
  gapRecords                      GapRecord[]
  gapRecordVersions               GapRecordVersion[]
  gapRecordVersionReviews         GapRecordVersionReview[]
  auditEvents                     AuditEvent[]
  documents                       Document[]
  evidences                       Evidence[]
  evidenceReviews                 EvidenceReview[]
  correctiveActions               CorrectiveAction[]
  correctiveActionEvidenceLinks   CorrectiveActionEvidence[]
  traceLots                       TraceLot[]
  traceLotLineages                TraceLotLineage[]
  traceLotGapRecordLinks          TraceLotGapRecord[]
  traceDispatches                 TraceDispatch[]
  traceDispatchLots               TraceDispatchLot[]
  traceabilityEvents              TraceabilityEvent[]
  traceabilityExercises           TraceabilityExercise[]
  retentionPolicies               RetentionPolicy[]
  retentionHolds                  RetentionHold[]
  retentionExecutions             RetentionExecution[]
  hazardousSubstanceProducts      HazardousSubstanceProduct[]
  hazardousSubstanceUseEvents     HazardousSubstanceUseEvent[]
  hazardousSubstanceStockEvents   HazardousSubstanceStockEvent[]
  hazardousSubstanceStorageChecks HazardousSubstanceStorageCheck[]
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  displayName             String
  passwordHash            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             Membership[]
  comments                AdvisoryComment[]
  gapRecordVersions       GapRecordVersion[]
  gapRecordVersionReviews GapRecordVersionReview[]
  authSessions            AuthSession[]
}

model AuthSession {
  id                    String    @id
  userId                String
  refreshTokenHash      String    @unique
  refreshTokenExpiresAt DateTime
  revokedAt             DateTime?
  lastUsedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshTokenExpiresAt])
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

model FarmSite {
  id                              String                           @id @default(cuid())
  organizationId                  String
  name                            String
  code                            String?
  locationText                    String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  organization                    Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plots                           Plot[]
  cropCycles                      CropCycle[]
  workers                         Worker[]
  operationLogs                   OperationLog[]
  traceLots                       TraceLot[]
  hazardousSubstanceUseEvents     HazardousSubstanceUseEvent[]
  hazardousSubstanceStorageChecks HazardousSubstanceStorageCheck[]

  @@index([organizationId])
}

model Plot {
  id                          String                       @id @default(cuid())
  farmSiteId                  String
  name                        String
  areaRai                     Float?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  farmSite                    FarmSite                     @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  cropCycles                  CropCycle[]
  operationLogs               OperationLog[]
  hazardousSubstanceUseEvents HazardousSubstanceUseEvent[]

  @@index([farmSiteId])
}

model CropCycle {
  id                          String                       @id @default(cuid())
  organizationId              String
  farmSiteId                  String
  plotId                      String?
  cropName                    String
  startedAt                   DateTime?
  endedAt                     DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite                    FarmSite                     @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  plot                        Plot?                        @relation(fields: [plotId], references: [id], onDelete: SetNull)
  operationLogs               OperationLog[]
  gapRecords                  GapRecord[]
  traceLots                   TraceLot[]
  hazardousSubstanceUseEvents HazardousSubstanceUseEvent[]

  @@index([organizationId, farmSiteId])
}

model Worker {
  id                              String                           @id @default(cuid())
  organizationId                  String
  farmSiteId                      String?
  fullName                        String
  phone                           String?
  roleTitle                       String?
  notes                           String?
  isActive                        Boolean                          @default(true)
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  organization                    Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite                        FarmSite?                        @relation(fields: [farmSiteId], references: [id], onDelete: SetNull)
  operationLogs                   OperationLog[]
  hazardousSubstanceUseEvents     HazardousSubstanceUseEvent[]
  hazardousSubstanceStockEvents   HazardousSubstanceStockEvent[]
  hazardousSubstanceStorageChecks HazardousSubstanceStorageCheck[]

  @@index([organizationId, isActive, createdAt])
  @@index([farmSiteId])
}

model OperationLog {
  id             String       @id @default(cuid())
  organizationId String
  farmSiteId     String
  plotId         String?
  cropCycleId    String?
  workerId       String?
  activityType   String
  occurredAt     DateTime
  notes          String?
  metadataJson   Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite       FarmSite     @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  plot           Plot?        @relation(fields: [plotId], references: [id], onDelete: SetNull)
  cropCycle      CropCycle?   @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  worker         Worker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, farmSiteId, occurredAt])
  @@index([cropCycleId, occurredAt])
  @@index([workerId, occurredAt])
}

model HazardousSubstanceProduct {
  id                     String                          @id @default(cuid())
  organizationId         String
  name                   String
  registrationNumber     String?
  activeIngredient       String?
  targetCrop             String?
  labelRateText          String?
  preHarvestIntervalDays Int?
  status                 HazardousSubstanceProductStatus @default(active)
  notes                  String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  useEvents              HazardousSubstanceUseEvent[]
  stockEvents            HazardousSubstanceStockEvent[]

  @@unique([organizationId, name])
  @@index([organizationId, status, createdAt])
}

model HazardousSubstanceUseEvent {
  id                 String                         @id @default(cuid())
  organizationId     String
  farmSiteId         String
  plotId             String
  cropCycleId        String?
  productId          String
  workerId           String
  appliedAt          DateTime
  quantity           Float
  quantityUnit       String
  reason             String
  applicationMethod  String?
  targetPest         String?
  weatherNotes       String?
  evidenceDocumentId String
  notes              String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite           FarmSite                       @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  plot               Plot                           @relation(fields: [plotId], references: [id], onDelete: Restrict)
  cropCycle          CropCycle?                     @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  product            HazardousSubstanceProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  worker             Worker                         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  evidenceDocument   Document                       @relation("HazardousSubstanceUseEvidenceDocument", fields: [evidenceDocumentId], references: [id], onDelete: Restrict)
  stockEvents        HazardousSubstanceStockEvent[]

  @@index([organizationId, appliedAt])
  @@index([organizationId, farmSiteId, appliedAt])
  @@index([organizationId, plotId, appliedAt])
  @@index([organizationId, productId, appliedAt])
  @@index([organizationId, workerId, appliedAt])
}

model HazardousSubstanceStockEvent {
  id                 String                           @id @default(cuid())
  organizationId     String
  productId          String
  eventType          HazardousSubstanceStockEventType
  occurredAt         DateTime
  quantity           Float
  quantityUnit       String
  workerId           String?
  useEventId         String?
  evidenceDocumentId String?
  reason             String?
  notes              String?
  createdAt          DateTime                         @default(now())
  organization       Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product            HazardousSubstanceProduct        @relation(fields: [productId], references: [id], onDelete: Restrict)
  worker             Worker?                          @relation(fields: [workerId], references: [id], onDelete: SetNull)
  useEvent           HazardousSubstanceUseEvent?      @relation(fields: [useEventId], references: [id], onDelete: SetNull)
  evidenceDocument   Document?                        @relation("HazardousSubstanceStockEvidenceDocument", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@index([organizationId, productId, occurredAt])
  @@index([organizationId, eventType, occurredAt])
  @@index([organizationId, useEventId])
}

model HazardousSubstanceStorageCheck {
  id                            String                               @id @default(cuid())
  organizationId                String
  farmSiteId                    String?
  checkedAt                     DateTime
  storageLocation               String
  checkedByWorkerId             String?
  approvedCropProductsSeparated Boolean
  lockedStorage                 Boolean
  labelsReadable                Boolean
  sdsAvailable                  Boolean
  spillKitAvailable             Boolean?
  result                        HazardousSubstanceStorageCheckResult
  issueNotes                    String?
  evidenceDocumentId            String?
  createdAt                     DateTime                             @default(now())
  updatedAt                     DateTime                             @updatedAt
  organization                  Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite                      FarmSite?                            @relation(fields: [farmSiteId], references: [id], onDelete: SetNull)
  checkedByWorker               Worker?                              @relation(fields: [checkedByWorkerId], references: [id], onDelete: SetNull)
  evidenceDocument              Document?                            @relation("HazardousSubstanceStorageEvidenceDocument", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@index([organizationId, checkedAt])
  @@index([organizationId, result, checkedAt])
  @@index([organizationId, farmSiteId, checkedAt])
}

model GapChecklist {
  id                      String                          @id @default(cuid())
  code                    String                          @unique
  title                   String
  description             String?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  gapRecords              GapRecord[]
  complianceControlPoints ComplianceControlPointVersion[]
}

model ComplianceScheme {
  id            String                    @id @default(cuid())
  code          String                    @unique
  name          String
  authorityName String?
  status        ComplianceSchemeStatus    @default(active)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  versions      ComplianceSchemeVersion[]
}

model ComplianceSchemeVersion {
  id            String                          @id @default(cuid())
  schemeId      String
  versionLabel  String
  publishedAt   DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isDefault     Boolean                         @default(false)
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt
  scheme        ComplianceScheme                @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  sections      ComplianceSectionVersion[]
  controlPoints ComplianceControlPointVersion[]

  @@unique([schemeId, versionLabel])
  @@index([schemeId, isDefault])
}

model ComplianceSectionVersion {
  id              String                          @id @default(cuid())
  schemeVersionId String
  code            String
  title           String
  description     String?
  sequence        Int
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  schemeVersion   ComplianceSchemeVersion         @relation(fields: [schemeVersionId], references: [id], onDelete: Cascade)
  controlPoints   ComplianceControlPointVersion[]
  evidences       Evidence[]                      @relation("EvidenceComplianceSection")

  @@unique([schemeVersionId, code])
  @@index([schemeVersionId, sequence])
}

model ComplianceControlPointVersion {
  id                   String                   @id @default(cuid())
  schemeVersionId      String
  sectionVersionId     String
  legacyChecklistId    String?                  @unique
  code                 String
  title                String
  requirementText      String?
  guidanceText         String?
  sequence             Int
  isActive             Boolean                  @default(true)
  requiresEvidence     Boolean                  @default(true)
  requiresExpertReview Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  schemeVersion        ComplianceSchemeVersion  @relation(fields: [schemeVersionId], references: [id], onDelete: Cascade)
  sectionVersion       ComplianceSectionVersion @relation(fields: [sectionVersionId], references: [id], onDelete: Cascade)
  legacyChecklist      GapChecklist?            @relation(fields: [legacyChecklistId], references: [id], onDelete: SetNull)
  evidences            Evidence[]               @relation("EvidenceComplianceControl")

  @@unique([schemeVersionId, code])
  @@index([sectionVersionId, sequence])
}

model GapRecord {
  id                 String              @id @default(cuid())
  organizationId     String
  cropCycleId        String?
  checklistId        String?
  currentVersionId   String?
  title              String
  notes              String?
  status             GapRecordStatus     @default(draft)
  reviewThreadStatus ReviewThreadStatus  @default(awaiting_review)
  recordedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cropCycle          CropCycle?          @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  checklist          GapChecklist?       @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  currentVersion     GapRecordVersion?   @relation("GapRecordCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  evidences          Evidence[]
  comments           AdvisoryComment[]
  correctiveActions  CorrectiveAction[]
  versions           GapRecordVersion[]  @relation("GapRecordVersions")
  traceLotLinks      TraceLotGapRecord[]

  @@index([organizationId, status])
  @@index([organizationId, currentVersionId])
}

model Evidence {
  id                              String                         @id @default(cuid())
  organizationId                  String
  gapRecordId                     String
  gapRecordVersionId              String?
  controlPointRef                 String?
  complianceSectionVersionId      String?
  complianceControlPointVersionId String?
  kind                            EvidenceKind
  storageKey                      String
  fileName                        String
  contentType                     String?
  fileSize                        Int?
  capturedAt                      DateTime?
  geoLat                          Float?
  geoLng                          Float?
  noteText                        String?
  documentId                      String?
  supersededAt                    DateTime?
  supersededByEvidenceId          String?
  submittedByUserId               String?
  submittedAt                     DateTime?
  reviewStatus                    EvidenceReviewStatus           @default(pending_review)
  lastReviewedByUserId            String?
  lastReviewedAt                  DateTime?
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt
  organization                    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gapRecord                       GapRecord                      @relation(fields: [gapRecordId], references: [id], onDelete: Cascade)
  gapRecordVersion                GapRecordVersion?              @relation(fields: [gapRecordVersionId], references: [id], onDelete: SetNull)
  document                        Document?                      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  supersededByEvidence            Evidence?                      @relation("EvidenceSupersession", fields: [supersededByEvidenceId], references: [id], onDelete: SetNull)
  supersedesEvidence              Evidence[]                     @relation("EvidenceSupersession")
  complianceSectionVersion        ComplianceSectionVersion?      @relation("EvidenceComplianceSection", fields: [complianceSectionVersionId], references: [id], onDelete: SetNull)
  complianceControlPointVersion   ComplianceControlPointVersion? @relation("EvidenceComplianceControl", fields: [complianceControlPointVersionId], references: [id], onDelete: SetNull)
  reviews                         EvidenceReview[]
  correctiveActionLinks           CorrectiveActionEvidence[]

  @@index([gapRecordId, kind])
  @@index([gapRecordVersionId])
  @@index([documentId])
  @@index([organizationId, supersededByEvidenceId, reviewStatus])
  @@index([organizationId, reviewStatus, createdAt])
  @@index([organizationId, controlPointRef, reviewStatus])
  @@index([organizationId, complianceSectionVersionId, reviewStatus])
  @@index([organizationId, complianceControlPointVersionId, reviewStatus])
}

model GapRecordVersion {
  id                    String                   @id @default(cuid())
  gapRecordId           String
  organizationId        String
  versionNumber         Int
  isCurrent             Boolean                  @default(true)
  supersededAt          DateTime?
  supersededByVersionId String?
  createdByUserId       String?
  titleSnapshot         String
  notesSnapshot         String?
  recordedAt            DateTime?
  createdAt             DateTime                 @default(now())
  gapRecord             GapRecord                @relation("GapRecordVersions", fields: [gapRecordId], references: [id], onDelete: Cascade)
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser         User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  supersededByVersion   GapRecordVersion?        @relation("GapRecordVersionSupersession", fields: [supersededByVersionId], references: [id], onDelete: SetNull)
  supersedesVersions    GapRecordVersion[]       @relation("GapRecordVersionSupersession")
  currentForGapRecord   GapRecord[]              @relation("GapRecordCurrentVersion")
  reviews               GapRecordVersionReview[]
  evidences             Evidence[]

  @@unique([gapRecordId, versionNumber])
  @@index([organizationId, gapRecordId, isCurrent])
  @@index([organizationId, supersededByVersionId])
}

model GapRecordVersionReview {
  id                 String                         @id @default(cuid())
  gapRecordVersionId String
  organizationId     String
  reviewerUserId     String
  decision           GapRecordVersionReviewDecision
  comment            String
  createdAt          DateTime                       @default(now())
  gapRecordVersion   GapRecordVersion               @relation(fields: [gapRecordVersionId], references: [id], onDelete: Cascade)
  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer           User                           @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@index([gapRecordVersionId, createdAt])
  @@index([organizationId, decision, createdAt])
}

model EvidenceReview {
  id             String                 @id @default(cuid())
  evidenceId     String
  organizationId String
  reviewerUserId String
  decision       EvidenceReviewDecision
  comment        String
  createdAt      DateTime               @default(now())
  evidence       Evidence               @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([evidenceId, createdAt])
  @@index([organizationId, decision, createdAt])
}

model AdvisoryComment {
  id           String    @id @default(cuid())
  gapRecordId  String
  authorUserId String
  body         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  gapRecord    GapRecord @relation(fields: [gapRecordId], references: [id], onDelete: Cascade)
  author       User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([gapRecordId, createdAt])
}

model CorrectiveAction {
  id                   String                     @id @default(cuid())
  organizationId       String
  gapRecordId          String
  title                String
  details              String
  controlPointRef      String?
  status               CorrectiveActionStatus     @default(open_unassigned)
  ownerUserId          String?
  createdByUserId      String
  dueAt                DateTime
  assignedAt           DateTime?
  submittedForReviewAt DateTime?
  verifiedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gapRecord            GapRecord                  @relation(fields: [gapRecordId], references: [id], onDelete: Cascade)
  evidenceLinks        CorrectiveActionEvidence[]

  @@index([organizationId, status, dueAt])
  @@index([organizationId, ownerUserId, status])
  @@index([gapRecordId, status])
}

model CorrectiveActionEvidence {
  id                 String           @id @default(cuid())
  correctiveActionId String
  evidenceId         String
  organizationId     String
  createdAt          DateTime         @default(now())
  correctiveAction   CorrectiveAction @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)
  evidence           Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([correctiveActionId, evidenceId])
  @@index([organizationId, correctiveActionId])
  @@index([organizationId, evidenceId])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  entityType     String
  entityId       String
  action         String
  payloadJson    Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
}

model Document {
  id                              String                           @id @default(cuid())
  organizationId                  String
  uploadedByUserId                String?
  kind                            DocumentKind
  status                          DocumentStatus                   @default(pending_upload)
  fileName                        String
  contentType                     String?
  declaredSize                    Int?
  storageProvider                 String                           @default("local_disk")
  storageKey                      String                           @unique
  blobSize                        Int?
  blobSha256                      String?
  uploadedAt                      DateTime?
  finalizedAt                     DateTime?
  failureReason                   String?
  metadataJson                    Json?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  organization                    Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs                            DocumentJob[]
  evidences                       Evidence[]
  hazardousSubstanceUseEvents     HazardousSubstanceUseEvent[]     @relation("HazardousSubstanceUseEvidenceDocument")
  hazardousSubstanceStockEvents   HazardousSubstanceStockEvent[]   @relation("HazardousSubstanceStockEvidenceDocument")
  hazardousSubstanceStorageChecks HazardousSubstanceStorageCheck[] @relation("HazardousSubstanceStorageEvidenceDocument")

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model DocumentJob {
  id               String            @id @default(cuid())
  documentId       String
  organizationId   String
  kind             DocumentJobKind
  status           DocumentJobStatus @default(pending)
  attemptCount     Int               @default(0)
  maxAttempts      Int               @default(3)
  scheduledAt      DateTime          @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  lastErrorMessage String?
  resultJson       Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  document         Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([documentId, kind])
  @@index([organizationId, status])
}

model TraceLot {
  id              String                 @id @default(cuid())
  organizationId  String
  farmSiteId      String
  cropCycleId     String?
  code            String
  commodityName   String
  varietyName     String?
  packHouseName   String?
  harvestedAt     DateTime
  packedAt        DateTime?
  status          TraceLotStatus         @default(open)
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmSite        FarmSite               @relation(fields: [farmSiteId], references: [id], onDelete: Cascade)
  cropCycle       CropCycle?             @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  parentLineages  TraceLotLineage[]      @relation("TraceLotLineageParent")
  childLineages   TraceLotLineage[]      @relation("TraceLotLineageChild")
  gapRecordLinks  TraceLotGapRecord[]
  dispatchLots    TraceDispatchLot[]
  events          TraceabilityEvent[]
  targetExercises TraceabilityExercise[]

  @@unique([organizationId, code])
  @@index([organizationId, harvestedAt])
  @@index([organizationId, cropCycleId, status])
  @@index([farmSiteId])
}

model TraceLotLineage {
  id               String                          @id @default(cuid())
  organizationId   String
  parentLotId      String
  childLotId       String
  relationshipType TraceLotLineageRelationshipType
  notes            String?
  createdByUserId  String?
  createdAt        DateTime                        @default(now())
  organization     Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentLot        TraceLot                        @relation("TraceLotLineageParent", fields: [parentLotId], references: [id], onDelete: Cascade)
  childLot         TraceLot                        @relation("TraceLotLineageChild", fields: [childLotId], references: [id], onDelete: Cascade)

  @@unique([parentLotId, childLotId, relationshipType])
  @@index([organizationId, parentLotId])
  @@index([organizationId, childLotId])
}

model TraceLotGapRecord {
  id              String                    @id @default(cuid())
  organizationId  String
  lotId           String
  gapRecordId     String
  linkType        TraceLotGapRecordLinkType
  createdByUserId String?
  createdAt       DateTime                  @default(now())
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lot             TraceLot                  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  gapRecord       GapRecord                 @relation(fields: [gapRecordId], references: [id], onDelete: Cascade)

  @@unique([lotId, gapRecordId, linkType])
  @@index([organizationId, lotId])
  @@index([organizationId, gapRecordId])
}

model TraceDispatch {
  id              String                       @id @default(cuid())
  organizationId  String
  code            String
  destinationName String
  destinationType TraceDispatchDestinationType
  shippedAt       DateTime
  status          TraceDispatchStatus          @default(draft)
  externalRefJson Json?
  createdByUserId String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lots            TraceDispatchLot[]
  events          TraceabilityEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, shippedAt])
}

model TraceDispatchLot {
  id             String        @id @default(cuid())
  organizationId String
  dispatchId     String
  lotId          String
  quantity       Float
  unit           String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dispatch       TraceDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  lot            TraceLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([dispatchId, lotId])
  @@index([organizationId, dispatchId])
  @@index([organizationId, lotId])
}

model TraceabilityEvent {
  id             String                @id @default(cuid())
  organizationId String
  lotId          String?
  dispatchId     String?
  exerciseId     String?
  actorUserId    String?
  eventType      String
  occurredAt     DateTime
  payloadJson    Json?
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lot            TraceLot?             @relation(fields: [lotId], references: [id], onDelete: SetNull)
  dispatch       TraceDispatch?        @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  exercise       TraceabilityExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, lotId, occurredAt])
  @@index([organizationId, dispatchId, occurredAt])
  @@index([organizationId, exerciseId, occurredAt])
}

model TraceabilityExercise {
  id                String                     @id @default(cuid())
  organizationId    String
  targetLotId       String
  status            TraceabilityExerciseStatus @default(running)
  startedAt         DateTime                   @default(now())
  completedAt       DateTime?
  initiatedByUserId String?
  resultJson        Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetLot         TraceLot                   @relation(fields: [targetLotId], references: [id], onDelete: Cascade)
  events            TraceabilityEvent[]

  @@index([organizationId, targetLotId, status])
  @@index([organizationId, startedAt])
}

model RetentionPolicy {
  id               String               @id @default(cuid())
  organizationId   String?
  subjectType      RetentionSubjectType
  retainDays       Int
  archiveAfterDays Int?
  purgeAfterDays   Int?
  legalBasis       String?
  activeFrom       DateTime             @default(now())
  activeTo         DateTime?
  isDefault        Boolean              @default(false)
  createdByUserId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions       RetentionExecution[]

  @@index([organizationId, subjectType, activeFrom])
  @@index([subjectType, isDefault])
}

model RetentionHold {
  id                String               @id @default(cuid())
  organizationId    String
  subjectType       RetentionSubjectType
  subjectId         String
  reason            String
  requestedByUserId String?
  releasedAt        DateTime?
  releasedByUserId  String?
  releaseReason     String?
  createdAt         DateTime             @default(now())
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, releasedAt])
}

model RetentionExecution {
  id             String                      @id @default(cuid())
  organizationId String
  subjectType    RetentionSubjectType
  subjectId      String
  policyId       String
  decision       RetentionExecutionDecision
  actorType      RetentionExecutionActorType @default(user)
  actorUserId    String?
  evidenceJson   Json?
  executedAt     DateTime                    @default(now())
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy         RetentionPolicy             @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, executedAt])
  @@index([policyId])
}
